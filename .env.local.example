# ── Local development (Demo mode) ──────────────────────────────────────────
# Leave Supabase empty → fake in-memory data, resets on restart, NOT linked to vercel.app
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Optional: connect local to Supabase (same DB as production — not recommended) ──
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Production (Vercel) ────────────────────────────────────────────────────
# Set NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in
# Vercel → Project → Settings → Environment Variables (Production only).
